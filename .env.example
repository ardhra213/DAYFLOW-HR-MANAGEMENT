# Copy this file to .env for local development. Never commit the resulting file.
# Every VITE_ value is embedded in browser JavaScript and must be client-safe.
# Example URL: https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=
# Example key: sb_publishable_YOUR_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=

# Keep both flags false for live deployments. Local Vite development still uses
# demo fixtures when Supabase is blank; production demo mode must be explicit.
VITE_ENABLE_DEMO_MODE=false
VITE_ALLOW_SELF_SIGNUP=false

# Server-only: used by api/invite-employee.js. Never prefix this with VITE_.
# Use a current sb_secret_ key or a legacy service_role key from Supabase.
SUPABASE_SERVICE_ROLE_KEY=
